# Task D: AI-Agent Harness Environment Variables

# Execution Mode (mock or provider)
# In mock mode, the harness uses a deterministic, rule-based mock client (no API keys required).
LLM_MODE=mock

# Optional live provider configuration (used only when LLM_MODE=provider)
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here_or_leave_blank_for_mock
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Security & Permissions
REQUIRE_HUMAN_APPROVAL_FOR_RISKY_TOOLS=true
WORKSPACE_ROOT=./benchmarks/fixtures/repo_a

# Trace & Logging
LOG_LEVEL=INFO
TRACE_DIR=./runs
